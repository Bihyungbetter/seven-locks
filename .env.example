# Copy to .env.local for local testing. On Vercel, set these under Project Settings > Environment Variables.
# Set one key. If OPENAI_API_KEY is set, the game uses OpenAI; otherwise it uses Groq.
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional: pick a different model (defaults: gpt-5.4-nano on OpenAI, openai/gpt-oss-20b on Groq)
# LLM_MODEL=gpt-5.4-mini
